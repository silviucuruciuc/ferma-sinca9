{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ferma-sinca9",
  // ID-ul contului Cloudflare PERSONAL (dash.cloudflare.com → dreapta jos pe pagina contului: „Account ID”).
  // Deploy-ul merge doar în acest cont; scripts/garda.mjs refuză placeholderul și orice cont Fortech/Aiperion.
  "account_id": "b9a549c2bee4fe0ead467ca80707a254",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/oauth/*", "/api/*"]
  },
  "vars": {
    // Client ID-ul aplicației OAuth GitHub (nu e secret). Secretul: npx wrangler secret put GITHUB_CLIENT_SECRET
    "GITHUB_CLIENT_ID": "",
    // public_repo dacă repo-ul e public (recomandat); „repo” dacă îl faci privat.
    "GITHUB_SCOPE": "public_repo",
    // Asistentul (/asistent/): aplicația Cloudflare Access care protejează /asistent și /api/asistent.
    // Echipa: Zero Trust → Settings → Custom Pages („<echipa>.cloudflareaccess.com”).
    // AUD: Zero Trust → Access → Applications → aplicația → „Application Audience (AUD) Tag”.
    // Secrete: npx wrangler secret put ASISTENT_EMAIL / GITHUB_TOKEN_ASISTENT
    "ACCESS_TEAM_DOMAIN": "rough-dream-b5a8.cloudflareaccess.com",
    "ACCESS_AUD": "5315d404de9d2f0fea61ff029a8076d6c24df8843f8a6f102054f944dccd9332"
  },
  "observability": { "enabled": true },
  // Custom domain: zona sinca9.ro e în contul Cloudflare personal.
  "routes": [{ "pattern": "ferma.sinca9.ro", "custom_domain": true }]
}
