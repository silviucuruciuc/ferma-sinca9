---
import { centru } from '../lib/teren.js';

interface Props {
  teren: any;
  pomi: any[];
  mini?: boolean;
  evidentiat?: string;
  id?: string;
  eticheta?: string;
  irigatii?: any;
  /** Stratul de irigații vizibil de la început (pe pagina /irigatii/). */
  cuIrigatii?: boolean;
}

const { teren, pomi, mini = false, evidentiat, id, eticheta = 'Planul terenului', irigatii, cuIrigatii = false } = Astro.props;
const { minX, maxX, minY, maxY } = teren.limite;
const M = mini ? 2 : 6;
const W = maxX - minX;
const H = maxY - minY;
const sy = (y: number) => +(maxY - y).toFixed(3);
const pts = (p: number[][]) => p.map(([x, y]) => `${x},${sy(y)}`).join(' ');

// Scara inițială a elementelor „de ecran” (simboluri, texte): metri pe pixel. JS o recalculează.
const K = mini ? 0 : +((W + 2 * M) / 1100).toFixed(4);
const scala = `scale(${K})`;

const grila5: { x1: number; y1: number; x2: number; y2: number; zece: boolean }[] = [];
if (!mini) {
  for (let x = Math.ceil((minX - M) / 5) * 5; x <= maxX + M; x += 5)
    grila5.push({ x1: x, y1: -M, x2: x, y2: H + M, zece: x % 10 === 0 });
  for (let y = Math.ceil((minY - M) / 5) * 5; y <= maxY + M; y += 5)
    grila5.push({ x1: minX - M, y1: sy(y), x2: maxX + M, y2: sy(y), zece: y % 10 === 0 });
}

const pePlan = pomi.filter((p) => p.pozitie);
---

<svg
  id={id}
  class:list={['plan', { 'plan-mini': mini, 'cu-irigatii': cuIrigatii }]}
  viewBox={`${minX - M} ${-M} ${W + 2 * M} ${H + 2 * M}`}
  preserveAspectRatio="xMidYMid meet"
  role={mini ? 'img' : 'application'}
  aria-label={eticheta}
  data-k={K}
>
  {
    !mini && (
      <g class="strat-grila" aria-hidden="true">
        {grila5.map((l) => (
          <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} class:list={['grila', { zece: l.zece }]} />
        ))}
      </g>
    )
  }

  <g class="strat-zone" aria-hidden="true">
    {
      teren.zone.map((z: any) => (
        <g class:list={['zona', `zona-${z.tip ?? 'alta'}`, { aprox: z.aproximativ }]}>
          {z.puncte.length > 2 ? <polygon points={pts(z.puncte)} /> : <polyline points={pts(z.puncte)} />}
        </g>
      ))
    }
  </g>

  <g class="strat-parcele">
    {teren.parcele.map((p: any) => <polygon class="parcela" points={pts(p.puncte)} />)}
  </g>

  {
    !mini && (
      <g class="strat-texte" aria-hidden="true">
        {teren.zone
          .filter((z: any) => z.nume)
          .map((z: any) => {
            const [cx, cy] = centru(z.puncte);
            const ys = z.puncte.map((p: number[]) => p[1]);
            const xs = z.puncte.map((p: number[]) => p[0]);
            const sus = ['livada', 'gradina'].includes(z.tip);
            const vertical = z.tip === 'drum' && Math.max(...ys) - Math.min(...ys) > Math.max(...xs) - Math.min(...xs);
            const ty = sus ? Math.max(...ys) - 1.2 : cy;
            return (
              <g transform={`translate(${cx.toFixed(2)} ${sy(ty)})${vertical ? ' rotate(-90)' : ''}`}>
                <g class="s" transform={scala}>
                  <text class:list={['text-zona', `text-${z.tip ?? 'alta'}`]} text-anchor="middle" y={sus ? 8 : 4}>
                    {z.nume}
                    {z.aproximativ ? ' (aprox.)' : ''}
                  </text>
                </g>
              </g>
            );
          })}
        {teren.repere.map((r: any) => (
          <g class="reper" transform={`translate(${r.x} ${sy(r.y)})`}>
            <g class="s" transform={scala}>
              <path d="M-5 0H5M0 -5V5" />
              <text x="8" y="4">
                {r.nume}
              </text>
            </g>
          </g>
        ))}
      </g>
    )
  }

  <g class="strat-spaliere" aria-hidden="true">
    {
      teren.spaliere.map((sp: any) => (
        <g class="spalier">
          <polyline class="spalier-sina" points={pts(sp.puncte)} />
          {sp.puncte.map((q: number[]) => (
            <circle class="spalier-stalp" cx={q[0]} cy={sy(q[1])} r="0.28" />
          ))}
        </g>
      ))
    }
  </g>

  {
    !mini && irigatii && (
      <g class="strat-irigatii" aria-hidden="true">
        {irigatii.acces && <polygon class="irig-acces" points={pts(irigatii.acces.puncte)} />}
        {irigatii.zone.map((z: any) => (
          <g class="irig-zona" style={`--z:${z.culoare}`}>
            {z.trasee.map((t: number[][]) => <polyline class="irig-teava" points={pts(t)} />)}
            {z.laterale.map((l: any) => <line class="irig-racord" x1={l.de[0]} y1={sy(l.de[1])} x2={l.la[0]} y2={sy(l.la[1])} />)}
            {z.inele.map((i: any) => <circle class="irig-inel" cx={i.x} cy={sy(i.y)} r={i.r} />)}
          </g>
        ))}
        {irigatii.zone.flatMap((z: any) =>
          z.traversari.map((t: any) => <line class="irig-traversare" x1={t.de[0]} y1={sy(t.de[1])} x2={t.la[0]} y2={sy(t.la[1])} />),
        )}
        {irigatii.zone.filter((z: any) => z.senzor).map((z: any) => (
          <g transform={`translate(${z.senzor.x} ${sy(z.senzor.y)})`} style={`--z:${z.culoare}`}>
            <g class="s" transform={scala}>
              <line class="irig-senzor-fir" x1="0" y1="0" x2={(z.senzor.ux * 16).toFixed(1)} y2={(-z.senzor.uy * 16).toFixed(1)} />
              <path class="irig-senzor" transform={`translate(${(z.senzor.ux * 16).toFixed(1)} ${(-z.senzor.uy * 16).toFixed(1)})`} d="M0 -6L6 0L0 6L-6 0Z" />
            </g>
          </g>
        ))}
        {irigatii.zone.map((z: any) => {
          const t = z.trasee.at(-1);
          const [x, y] = t.at(-1);
          return (
            <g transform={`translate(${x} ${sy(y)})`} style={`--z:${z.culoare}`}>
              <g class="s" transform={scala}>
                <text class="irig-cod" x="6" y="-6">{z.cod}</text>
              </g>
            </g>
          );
        })}
        {irigatii.cutie && (
          <g transform={`translate(${irigatii.cutie.x} ${sy(irigatii.cutie.y)})`}>
            <g class="s" transform={scala}>
              <rect class="irig-cutie" x="-7" y="-7" width="14" height="14" rx="2" />
              <text class="irig-cutie-text" y="3.5" text-anchor="middle">C</text>
            </g>
          </g>
        )}
      </g>
    )
  }

  <g class="strat-coroane" aria-hidden="true">
    {
      pePlan.map((p) =>
        p.pozitie.ux != null ? (
          <rect
            class="coroana coroana-palisata"
            data-id={p.id}
            x={(-p.pozitie.latime / 2).toFixed(2)}
            y={(-p.pozitie.adancime / 2).toFixed(2)}
            width={p.pozitie.latime.toFixed(2)}
            height={p.pozitie.adancime.toFixed(2)}
            transform={`translate(${p.pozitie.x} ${sy(p.pozitie.y)}) rotate(${(-Math.atan2(p.pozitie.uy, p.pozitie.ux) * 180 / Math.PI).toFixed(2)})`}
            style={`--c:${p.specieInfo.culoare}`}
          />
        ) : (
          <circle
            class="coroana"
            data-id={p.id}
            cx={p.pozitie.x}
            cy={sy(p.pozitie.y)}
            r={(p.coroana / 2).toFixed(2)}
            style={`--c:${p.specieInfo.culoare}`}
          />
        ),
      )
    }
  </g>

  <g class="strat-pomi">
    {
      pePlan.map((p) =>
        mini ? (
          <circle
            class:list={['pom-mini', { evidentiat: p.id === evidentiat }]}
            cx={p.pozitie.x}
            cy={sy(p.pozitie.y)}
            r={p.id === evidentiat ? 0.9 : 0.45}
            style={`--c:${p.specieInfo.culoare}`}
          />
        ) : (
          <a
            href={p.url}
            class="pom"
            data-id={p.id}
            data-specie={p.specie}
            data-grupa={p.grupa}
            data-stare={p.stare}
            transform={`translate(${p.pozitie.x} ${sy(p.pozitie.y)})`}
            style={`--c:${p.specieInfo.culoare}`}
            aria-label={`${p.eticheta}: ${p.soiNume}${p.portaltoiNume ? ' / ' + p.portaltoiNume : ''}`}
          >
            <g class="s simbol" transform={scala}>
              <circle class="inel" r="11" />
              {p.forma === 'patrat' ? (
                <rect class="forma" x="-5.5" y="-5.5" width="11" height="11" rx="2" />
              ) : p.forma === 'romb' ? (
                <rect class="forma" x="-5" y="-5" width="10" height="10" rx="1" transform="rotate(45)" />
              ) : (
                <circle class="forma" r="6.5" />
              )}
            </g>
            <g class="s eticheta-pom" transform={scala}>
              <text y="-12" text-anchor="middle">
                {p.id}
              </text>
            </g>
          </a>
        ),
      )
    }
  </g>
  <g class="strat-masura" aria-hidden="true"></g>
  <g class="strat-ui"></g>
</svg>

<style is:global>
  .plan {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--alb);
    font-family: var(--font);
    user-select: none;
    -webkit-user-select: none;
  }

  .plan .grila {
    stroke: #e4e9e4;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .plan .grila.zece {
    stroke: #d3dbd4;
  }

  .plan .parcela {
    fill: rgb(238 241 236 / 0.55);
    stroke: var(--cerneala);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }

  .plan .zona polygon,
  .plan .zona polyline {
    fill: rgb(28 42 38 / 0.04);
    stroke: var(--grafit);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .plan .zona.aprox polygon,
  .plan .zona.aprox polyline {
    stroke-dasharray: 5 4;
  }

  .plan .zona-livada polygon {
    fill: rgb(91 138 54 / 0.08);
    stroke: rgb(91 138 54 / 0.7);
  }

  .plan .zona-gradina polygon {
    fill: rgb(192 149 28 / 0.08);
  }

  .plan .zona-constructie polygon {
    fill: rgb(28 42 38 / 0.12);
  }

  .plan .zona-drum polygon {
    fill: #dfe3dc;
    stroke: none;
  }

  .plan .zona-apa polygon {
    fill: rgb(58 92 163 / 0.12);
  }

  .plan .zona-compost polygon {
    fill: rgb(122 84 42 / 0.18);
    stroke: rgb(122 84 42 / 0.75);
  }

  .plan .zona-poarta polyline {
    fill: none;
    stroke: var(--eticheta);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .plan .masura-linie {
    fill: none;
    stroke: #1d63b8;
    stroke-width: 2;
    stroke-dasharray: 6 4;
    vector-effect: non-scaling-stroke;
  }

  .plan .masura-pct circle {
    fill: var(--alb);
    stroke: #1d63b8;
    stroke-width: 2;
  }

  .plan .masura-et text {
    fill: #1d63b8;
    font-weight: 700;
    font-size: 12px;
  }

  .plan text {
    fill: var(--cerneala);
    font-stretch: 75%;
    font-size: 12px;
    paint-order: stroke;
    stroke: var(--alb);
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  .plan .text-zona {
    fill: var(--grafit);
    font-weight: 560;
  }

  .plan .text-drum {
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .plan .reper path {
    stroke: var(--cerneala);
    stroke-width: 1.5;
  }

  .plan .spalier-sina {
    fill: none;
    stroke: var(--grafit);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
  }

  .plan .spalier-stalp {
    fill: var(--cerneala);
  }

  .plan .coroana-palisata {
    rx: 0.15;
  }

  /* Irigații (schiță) — ascunse până se bifează stratul. Nuanțe reci, departe de culorile de status. */
  .plan .strat-irigatii {
    display: none;
    pointer-events: none;
  }
  .plan.cu-irigatii .strat-irigatii {
    display: inline;
  }
  .plan .irig-acces {
    fill: rgb(28 42 38 / 0.06);
    stroke: var(--grafit);
    stroke-width: 1;
    stroke-dasharray: 6 4;
    vector-effect: non-scaling-stroke;
  }
  .plan .irig-teava {
    fill: none;
    stroke: var(--z);
    stroke-width: 2.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .plan .irig-racord {
    stroke: var(--z);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }
  .plan .irig-inel {
    fill: none;
    stroke: var(--z);
    stroke-width: 1.5;
    stroke-dasharray: 2 2;
    vector-effect: non-scaling-stroke;
  }
  .plan .irig-traversare {
    stroke: var(--cerneala);
    stroke-width: 7;
    stroke-opacity: 0.25;
    stroke-linecap: butt;
    vector-effect: non-scaling-stroke;
  }
  .plan .irig-senzor {
    fill: var(--alb);
    stroke: var(--z);
    stroke-width: 2;
  }
  .plan .irig-senzor-fir {
    stroke: var(--z);
    stroke-width: 1.5;
  }
  .plan .irig-cod {
    fill: var(--z);
    font-size: 11px;
    font-weight: 700;
  }
  .plan .irig-cutie {
    fill: var(--cerneala);
  }
  .plan .irig-cutie-text {
    fill: var(--alb);
    font-size: 10px;
    font-weight: 700;
  }

  .plan .coroana {
    fill: color-mix(in srgb, var(--c) 9%, transparent);
    stroke: color-mix(in srgb, var(--c) 55%, transparent);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  .plan.fara-coroane .coroana {
    display: none;
  }

  .plan .pom {
    cursor: pointer;
    outline: none;
  }

  .plan .pom .forma {
    fill: var(--c);
    stroke: var(--alb);
    stroke-width: 1.5;
  }

  .plan .pom[data-stare='comandat'] .forma {
    fill: var(--alb);
    stroke: var(--c);
    stroke-width: 2.5;
    stroke-dasharray: 3 2;
  }

  .plan .pom .inel {
    fill: transparent;
    stroke: none;
  }

  .plan .pom[data-stare='problema'] .inel,
  .plan .pom[data-stare='observatie'] .inel {
    stroke: var(--alerta);
    stroke-width: 2;
    r: 9.5px;
  }

  .plan .pom[data-stare='observatie'] .inel {
    stroke: var(--atentie);
  }

  .plan .pom:hover .inel,
  .plan .pom:focus-visible .inel {
    stroke: var(--cerneala);
    stroke-width: 2;
  }

  .plan .pom.selectat .inel {
    fill: var(--eticheta);
    stroke: var(--cerneala);
    stroke-width: 2;
    r: 12px;
  }

  .plan .eticheta-pom {
    display: none;
  }

  .plan.zoom-apropiat .eticheta-pom,
  .plan .pom.selectat .eticheta-pom {
    display: inline;
  }

  .plan .eticheta-pom text {
    font-weight: 680;
    font-size: 11px;
  }

  .plan .pom.estompat {
    opacity: 0.18;
  }

  .plan .pom.ascuns,
  .plan .coroana.ascuns {
    display: none;
  }

  .plan-mini {
    height: auto;
    aspect-ratio: auto;
    border: 1px solid var(--linie);
    border-radius: var(--r);
  }

  .plan-mini .pom-mini {
    fill: var(--c);
    opacity: 0.55;
  }

  .plan-mini .pom-mini.evidentiat {
    opacity: 1;
    stroke: var(--cerneala);
    stroke-width: 2.5;
    vector-effect: non-scaling-stroke;
    paint-order: stroke;
  }
</style>
